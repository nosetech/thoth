# thoth 監視対象アプリ定義（設計: docs/architecture.md「アプリ管理モデル」）。
# config/apps.yaml にコピーして使う（apps.yaml は git 管理しない）。
apps:
  - id: sample-app
    name: Sample App
    workdir: ~/repo/sample-app
    modes:
      local: {}
      lan: { env: { LAN_IP: "${LAN_IP}" } }
      vpn: { env: { TAILSCALE_IP: "${TAILSCALE_IP}" } }
    services:
      - id: backend
        kind: process
        start: [uv, run, python, -m, app.main]
        workdir: backend
        port: 8000
        healthcheck: { type: http, url: "http://127.0.0.1:8000/api/health" }
        auto_restart: { max_retries: 5 }   # 異常時に自動再起動（省略時は無効）
      # 起動スクリプト型: start が対象をバックグラウンド起動して終了する。PID は pid_file（workdir 基準）が正
      - id: scripted
        kind: process
        start: [./bin/start.sh]
        stop: [./bin/stop.sh]
        pid_file: logs/app.pid
        pid_match: app.main   # 古い PID ファイル対策。PID のコマンドラインに含まれる文字列（推奨）
        port: 8001
        healthcheck: { type: pid, interval: 60 }   # tcp / http / pid / command から選ぶ
        start_timeout: 300   # start の終了を待つ上限（秒）。既定 30
        stop_timeout: 60
      - id: daily-job
        kind: scheduled
        launchd_label: com.example.sample-app.daily
        schedule: "毎日 03:00"
        expected_interval: 86400
